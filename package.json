{
  "name": "cooldown-registry-proxy-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite site --host 0.0.0.0",
    "test": "cargo test && npm run test:site",
    "test:site": "node --test site/src/*.test.js",
    "build": "cargo build --release && npm run build:site && mkdir -p dist/bin && cp target/release/cooldown-registry-proxy dist/bin/",
    "build:site": "vite build site --outDir ../dist/site --emptyOutDir"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  }
}

